# ==============================================================================
# ConvertAudit AI — Production Environment Configuration
# ==============================================================================

# Database (PostgreSQL 16 with UUIDv7, RLS, and schema.sql partitioning)
DATABASE_URL=postgresql://convertaudit:convertaudit_secret_2026@localhost:5432/convertaudit
POSTGRES_USER=convertaudit
POSTGRES_PASSWORD=convertaudit_secret_2026
POSTGRES_DB=convertaudit

# Caching & BullMQ Queue (Redis 7)
REDIS_URL=redis://:convertaudit_redis_2026@localhost:6379
REDIS_PASSWORD=convertaudit_redis_2026

# AI LLM Provider for 5-Second Clarity Blind Comprehension
# Claude 3.5 Sonnet / Haiku with prompt caching
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Object Storage (Cloudflare R2 / AWS S3) for Screenshots, Artifacts, and PDFs
S3_BUCKET=convertaudit-artifacts
S3_REGION=auto
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=your_access_key_id
S3_SECRET_ACCESS_KEY=your_secret_access_key

# Web Application URLs
PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000
